; Engine configuration file.
; The Extrecated (working title) — community center blockout.

config_version=5

[application]

config/name="The Extrecated"
config/description="Survival horror, fixed cameras, PS1 look. Prologue blockout."
run/main_scene="res://scenes/prologue/prologue.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

GameSettings="*res://scripts/systems/game_settings.gd"
Cameras="*res://scripts/cameras/camera_director.gd"
HUD="*res://scripts/ui/hud.gd"
Dialogue="*res://scripts/dialogue/dialogue_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="enemy"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0

[gui]

fonts/dynamic_fonts/use_oversampling=false
